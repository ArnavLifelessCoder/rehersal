# Copy to backend/.env and fill in what you need. Everything is optional --
# the app runs fully offline with no .env at all.

# --- interviewer brain ---
# Free local LLM. Install Ollama, then: ollama pull qwen2.5:3b-instruct
# On "auto" it's detected and preferred over the concept graph automatically.
# REHEARSAL_BRAIN_BACKEND=ollama
# REHEARSAL_OLLAMA_MODEL=qwen2.5:3b-instruct
# REHEARSAL_OLLAMA_HOST=http://127.0.0.1:11434

# Hosted (best quality, cents per session)
# REHEARSAL_ANTHROPIC_API_KEY=sk-ant-...
# REHEARSAL_BRAIN_MODEL=claude-haiku-4-5-20251001
# REHEARSAL_OPENAI_API_KEY=sk-...

# --- turn-taking feel ---
# Raise these if it still cuts you off while you think; lower them if the
# interviewer feels sluggish to respond.
# REHEARSAL_ENDPOINT_SILENCE_MS=1200      # base pause before the interviewer replies
# REHEARSAL_THINKING_GRACE_MS=1100        # extra wait when you trail off mid-thought
# REHEARSAL_OPENING_GRACE_MS=1400         # extra wait while the answer is still short
# REHEARSAL_OPENING_GRACE_WORDS=12        # what counts as "still short"
# REHEARSAL_STUCK_SILENCE_MS=12000        # silence before offering a hint
# REHEARSAL_RAMBLE_LIMIT_MS=120000        # talking time before a polite interrupt
# REHEARSAL_MAX_QUESTIONS_PER_SESSION=12

# --- backends: "auto" picks the real one if importable, else the fallback ---
# REHEARSAL_ASR_BACKEND=auto              # auto | faster-whisper | mock
# REHEARSAL_ASR_MODEL=base.en             # tiny.en is faster, small.en needs a GPU
# REHEARSAL_VAD_BACKEND=auto              # auto | silero | energy
# REHEARSAL_TTS_BACKEND=auto              # auto | piper | browser
# REHEARSAL_EMBED_BACKEND=auto            # auto | sentence-transformers | lexical

# --- noise rejection (raise these if your room is loud) ---
# REHEARSAL_MIN_UTTERANCE_MS=600          # speech needed before silence ends a turn
# REHEARSAL_SPEECH_ONSET_MS=200           # sustained speech needed to open a turn
# REHEARSAL_MIN_ANSWER_WORDS=3            # transcripts shorter than this are noise
# REHEARSAL_MIN_TURN_RMS=0.004            # audio energy a turn must reach to be real
# REHEARSAL_FLOOR_SETTLE_MS=350           # audio dropped after the floor opens (echo tail)

# --- recordings (what makes worst-moment playback work) ---
# REHEARSAL_STORE_AUDIO=true
# REHEARSAL_BLOB_RETENTION_DAYS=7
# REHEARSAL_BLOB_MAX_TOTAL_MB=512

# --- abuse limits ---
# REHEARSAL_MAX_CONCURRENT_SESSIONS=8
# REHEARSAL_RATE_LIMIT_SESSIONS_PER_HOUR=20

# --- storage ---
# REHEARSAL_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/rehearsal

# --- frontend origins allowed to connect ---
# REHEARSAL_CORS_ORIGINS=http://localhost:5173,https://rehearsal.example.com
